# Required for local development: NeonDB or PostgreSQL storage
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional OpenRouter model (defaults to openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional OpenRouter base URL (defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Backward-compatibility fallback if using OPENAI_API_KEY
# OPENAI_API_KEY=

# Optional GoHighLevel or generic webhook destination. The deployed assessment uses a redacted demo notifier when absent.
OUTBOUND_WEBHOOK_URL=

# GitHub OAuth (https://github.com/settings/applications/new)
GITHUB_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Managed platform values (optional)
JWT_SECRET=replace-with-a-long-random-string
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
