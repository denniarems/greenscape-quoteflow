# Required for local development: persistent MySQL-compatible storage
DATABASE_URL=mysql://user:password@host:3306/quoteflow

# Optional direct OpenAI fallback. Managed deployments use injected gateway credentials.
OPENAI_API_KEY=

# Optional GoHighLevel or generic webhook destination. The deployed assessment uses a redacted demo notifier when absent.
OUTBOUND_WEBHOOK_URL=

# Managed platform values
JWT_SECRET=replace-with-a-long-random-string
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
